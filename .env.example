APP_NAME="Inova7 Acadêmico"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Fortaleza
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql

# Ambiente local no Windows com Docker exposto no host:
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_DATABASE=inova7_academico
# DB_USERNAME=root
# DB_PASSWORD=root

# Ambiente dentro do container Docker da aplicação:
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=inova7_academico
# DB_USERNAME=root
# DB_PASSWORD=root

DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=inova7_academico
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
